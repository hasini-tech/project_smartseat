# Copy this file to .env and replace the placeholders with real values.
MONGO_URI="mongodb://127.0.0.1:27017/smartseat"
# For MongoDB Atlas, use a URI such as:
# MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartseat"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
DEFAULT_TENANT_NAME="ABC COLLEGE"
PORT=4000
